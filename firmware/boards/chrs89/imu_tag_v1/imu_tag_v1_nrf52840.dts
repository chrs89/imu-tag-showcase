/*
 * Board DTS, IMU Tag v1, PCBA revision 1.1.0
 * Module : E73-2G4M08S1C (nRF52840QIAA)
 * Flash  : MX25R6435F (64 Mbit / 8 MB, QSPI)
 * IMU    : LSM6DSV16X (SPI1, INT1=P0.30, INT2=P0.08)
 * Mag    : LIS2MDL (I2C0)
 * NFC    : antenna on NFC1/NFC2 (P0.09/P0.10)
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "imu_tag_v1_nrf52840-pinctrl.dtsi"
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/regulator/nrf5x.h>
#include <zephyr/dt-bindings/sensor/lsm6dsvxxx.h>

/ {
	model = "IMU Tag v1";
	compatible = "chrs89,imu-tag-v1";

	chosen {
		/*
		 * UART0 is not wired on the PCB. Console and shell go through
		 * Segger RTT (CONFIG_RTT_CONSOLE in prj.conf), so zephyr,console
		 * and zephyr,shell-uart are left unset.
		 */
		zephyr,sram           = &sram0;
		zephyr,flash          = &flash0;
		zephyr,flash-controller = &flash_controller;
		zephyr,code-partition = &slot0_partition;
		/* Nordic Partition Manager "external_flash" region. */
		nordic,pm-ext-flash   = &mx25r64;
	};

	/*
	 * Status LED on PWM0 channel 0 (P1.13 -> R5 -> D2 -> GND, active high).
	 * PWM instead of gpio-leds gives brightness control for fade patterns.
	 */
	pwmleds: pwmleds {
		compatible = "pwm-leds";
		led0_pwm: led_pwm_0 {
			pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "Status LED";
		};
	};

	/*
	 * Battery sense, GPIO gated:
	 *   VBAT --R2 (820 k)-- BATTERY_PIN (AIN1/P0.03) --R3 (2 M)-- GPIO_BAT_MEAS (P0.28)
	 *   C1 (10 nF) from BATTERY_PIN to GND.
	 * GPIO_BAT_MEAS floats (input) while idle, so the divider draws no
	 * current; firmware drives it low only for the duration of a sample.
	 * Then BATTERY_PIN = VBAT x R3/(R2+R3) = 0.7092 x VBAT.
	 * R2 || R3 = 582 k, hence ADC_GAIN_1_6, internal reference and the
	 * longest acquisition time (40 us) on the channel below.
	 */
	zephyr,user {
		io-channels = <&adc 1>;
		bat-meas-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
	};

	aliases {
		led0         = &led0_pwm;
		imu0         = &lsm6dsv16x;
		stream0      = &lsm6dsv16x;
		mag-sensor0  = &lis2mdl;
	};
};

/* UART0: P0.28/P0.29 are used as GPIO_BAT_MEAS and SPI1 MOSI on this PCBA. */
&uart0 { status = "disabled"; };

/*
 * REG1 (main core regulator) in DC/DC mode.
 *
 * Confirmed against the schematic: DCC -> 10 uH inductor -> VDD, with DEC4
 * and DEC6 tied together and commonly decoupled, the Nordic reference
 * wiring for REG1 DC/DC mode. REG0 (the HV stage, VDDH/DCCH/DECUSB) has no
 * inductor and keeps the SoC default.
 *
 * The hardware falls back to LDO on its own at very low load, so DC/DC
 * costs nothing in System OFF and only engages while the radio, the buses
 * or the CPU draw current.
 */
&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

/* I2C0: LIS2MDL magnetometer (SDA=P0.07, SCL=P0.12). */
&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;
	/*
	 * twim_nrfx does not call pm_device_runtime_enable() itself. Opt in
	 * per node rather than through CONFIG_PM_DEVICE_RUNTIME_DEFAULT_ENABLE,
	 * which would also catch &gpio0/&gpio1 and break INT2 edge interrupt
	 * delivery (see the prj.conf comment).
	 */
	zephyr,pm-device-runtime-auto;

	lis2mdl: lis2mdl@1e {
		compatible = "st,lis2mdl";
		reg = <0x1e>;
		status = "okay";
	};
};

/* Unused buses. */
&i2c1   { status = "disabled"; };
&spi0   { status = "disabled"; };

/*
 * SPI1: LSM6DSV16X IMU (SCK=P0.02, MOSI=P0.29, MISO=P0.31, CS=P0.05).
 *
 * INT1 (P0.30) carries the FIFO watermark interrupt. INT2 (P0.08) carries
 * the event engine interrupts (tap, free-fall, motion) and is bonded to
 * P1.09 on this PCBA as the System OFF wake pin; P1.09 is left unclaimed
 * here on purpose.
 *
 * SPI1 is deliberately NOT opted into runtime power management, unlike
 * I2C0, QSPI and PWM0: the IMU FIFO runs continuously from boot until
 * System OFF and the bus is needed again within 33 ms of any idle moment.
 * Letting it auto-suspend during extended idle stalled the next FIFO read
 * on resume and starved the watchdog every 66 s (confirmed on device).
 */
&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;   /* P0.05 */

	lsm6dsv16x: lsm6dsv16x@0 {
		compatible = "st,lsm6dsv16x";
		reg = <0>;
		status = "okay";

		spi-max-frequency = <8000000>;
		spi-cpol;
		spi-cpha;   /* SPI mode 3 */

		int1-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;   /* P0.30 */
		int2-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;    /* P0.08 */
		/* drdy-pin = <1>: data-ready and FIFO interrupts routed to INT1. */
		drdy-pin = <1>;

		/*
		 * Boot-time defaults; the sample rate is changed at runtime by the
		 * firmware. Values use the binding macros from lsm6dsvxxx.h.
		 * accel-range is in g (binding: 2 = 2 g), gyro-range in dps.
		 */
		accel-odr              = <LSM6DSVXXX_DT_ODR_AT_240Hz>;
		accel-range            = <2>;   /* 2 g */
		gyro-odr               = <LSM6DSVXXX_DT_ODR_AT_240Hz>;
		gyro-range             = <4>;   /* 2000 dps */
		drdy-pulsed;
	};
};

/*
 * QSPI: MX25R6435F 8 MB NOR flash. nrf_qspi_nor reads the JEDEC ID at boot
 * and fails with -ENODEV on mismatch, so jedec-id must match the assembled
 * chip. jedec-id and sfdp-bfp are taken from Nordic's nrf52840dk_nrf52840.dts,
 * which assembles the same chip.
 */
&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";
	/* See &i2c0 above: nrf_qspi_nor does not self-enable runtime PM. */
	zephyr,pm-device-runtime-auto;

	mx25r64: mx25r6435f@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		sck-frequency = <8000000>;

		/* JEDEC ID: C2h = Macronix, 28h = MX25R, 17h = 64 Mbit */
		jedec-id = [c2 28 17];

		sfdp-bfp = [
			e5 20 f1 ff  ff ff ff 03  44 eb 08 6b  08 3b 04 bb
			ee ff ff ff  ff ff 00 ff  ff ff 00 ff  0c 20 0f 52
			10 d8 00 ff  23 72 f5 00  82 ed 04 cc  44 83 68 44
			30 b0 30 b0  f7 c4 d5 5c  00 be 29 ff  f0 d0 ff ff
		];

		size = <67108864>;    /* 64 Mbit in bits */
		has-dpd;
		/* MX25R6435F datasheet deep power-down timing. */
		t-enter-dpd = <10000>;  /* 10 us */
		t-exit-dpd  = <35000>;  /* 35 us */

		/* The whole chip as one partition; no firmware user yet. */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			log_partition: partition@0 {
				label = "log_partition";
				reg = <0x000000 0x800000>;  /* 8 MB */
			};
		};
	};
};

/* GPIO */
&gpiote { status = "okay"; };
&gpio0  { status = "okay"; };
&gpio1  { status = "okay"; };

/* PWM0: status LED brightness control (OUT0 = P1.13). */
&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
	/*
	 * See &i2c0 above: pwm_nrfx does not self-enable runtime PM. This is
	 * what makes the LED module's pm_device_runtime_get/put calls effective.
	 */
	zephyr,pm-device-runtime-auto;
};

/*
 * SAADC: battery voltage sense on AIN1 (P0.03), single ended, internal
 * 0.6 V reference with 1/6 gain = 3.6 V full scale. See zephyr,user above
 * for the divider.
 */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
	};
};

/*
 * NFCT: NFC wake-up and LE Secure Connections OOB pairing. The antenna is
 * on NFC1/NFC2 (P0.09/P0.10), which nothing else claims, so no UICR
 * pin-mode override is needed.
 */
&nfct   { status = "okay"; };

/* Internal flash partitions: MCUboot plus two image slots and settings. */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x0000C000>;  /* 48 KB */
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000C000 0x00076000>;  /* 472 KB */
		};

		slot1_partition: partition@82000 {
			label = "image-1";
			reg = <0x00082000 0x00076000>;  /* 472 KB */
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000F8000 0x00008000>;  /* 32 KB */
		};
	};
};
