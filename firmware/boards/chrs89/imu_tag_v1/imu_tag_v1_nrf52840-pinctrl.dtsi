/*
 * Pin control definitions for IMU Tag v1 (E73-2G4M08S1C / nRF52840)
 * PCBA revision 1.0.0 (default) — GD25Q64ESIG QSPI flash.
 *
 * Pin map (from schematic):
 *   SPI1  : SCK=P1.10  MOSI=P1.11  MISO=P1.13  CS(GPIO)=P0.03
 *   I2C0  : SDA=P1.04  SCL=P1.06
 *   QSPI  : SCK=P0.13  IO0=P0.17   IO1=P0.20   IO2=P0.22  IO3=P0.24  CSN=P0.15
 *   UART0 : TX=P0.28   RX=P0.29    (disabled — not wired on the PCB, see &uart0)
 *   PWM0  : OUT0=P0.07 (status LED — drives D2/LED1 through R5 for brightness fades)
 *   SAADC : AIN2=P0.04 (BATTERY_PIN — VBAT through R2/R3 divider, no pinctrl needed;
 *                       analog inputs are dedicated SAADC pins, not pin-muxed)
 *
 * PCBA revision 1.1.0 re-routes almost every peripheral to different pins
 * (confirmed against the new schematic — this was NOT just a flash-chip
 * swap) — see imu_tag_v1_nrf52840_1_1_0-pinctrl.dtsi. Only QSPI SCK/IO1/
 * IO2/CSN happen to be unchanged; QSPI IO0 and IO3 are swapped (P0.17 and
 * P0.24 trade roles) — do not assume "QSPI pins are shared" from this file
 * alone.
 */

#include <dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {

	/* ── UART0 (shell / debug console) ─────────────────────────────────── */
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 28)>,   /* P0.28 */
			        <NRF_PSEL(UART_RX, 0, 29)>;   /* P0.29 */
		};
	};
	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 28)>,
			        <NRF_PSEL(UART_RX, 0, 29)>;
			low-power-enable;
		};
	};

	/* ── I2C0  — LIS2MDL magnetometer (SDA=P1.04, SCL=P1.06) ───────────── */
	/* External 4.7 kΩ pull-ups R16/R18 are present on the PCB. */
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,   /* P1.04 */
			        <NRF_PSEL(TWIM_SCL, 1, 6)>;   /* P1.06 */
		};
	};
	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
			        <NRF_PSEL(TWIM_SCL, 1, 6)>;
			low-power-enable;
		};
	};

	/* ── PWM0  — status LED brightness control (OUT0=P0.07) ────────────── */
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 7)>;   /* P0.07 */
		};
	};
	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 7)>;
			low-power-enable;
		};
	};

	/* ── SPI1  — LSM6DSV16X IMU (SCK=P1.10, MOSI=P1.11, MISO=P1.13) ───── */
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 10)>,  /* P1.10 */
			        <NRF_PSEL(SPIM_MOSI, 1, 11)>,  /* P1.11 */
			        <NRF_PSEL(SPIM_MISO, 1, 13)>;  /* P1.13 */
		};
	};
	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 10)>,
			        <NRF_PSEL(SPIM_MOSI, 1, 11)>,
			        <NRF_PSEL(SPIM_MISO, 1, 13)>;
			low-power-enable;
		};
	};

	/* ── QSPI  — external NOR flash, PCBA rev 1.0.0 (GD25Q64ESIG).
	 * Rev 1.1.0 (MX25R6435F) swaps IO0 and IO3 between P0.17/P0.24 — see
	 * imu_tag_v1_nrf52840_1_1_0-pinctrl.dtsi; SCK/IO1/IO2/CSN are the only
	 * pins actually unchanged between revisions. ─────────────────────── */
	qspi_default: qspi_default {
		group1 {
			psels = <NRF_PSEL(QSPI_SCK, 0, 13)>,   /* P0.13 */
			        <NRF_PSEL(QSPI_IO0, 0, 17)>,    /* P0.17 — SI  */
			        <NRF_PSEL(QSPI_IO1, 0, 20)>,    /* P0.20 — SO  */
			        <NRF_PSEL(QSPI_IO2, 0, 22)>,    /* P0.22 — WP# */
			        <NRF_PSEL(QSPI_IO3, 0, 24)>,    /* P0.24 — HOLD# */
			        <NRF_PSEL(QSPI_CSN, 0, 15)>;    /* P0.15 — CS  */
		};
	};
	qspi_sleep: qspi_sleep {
		group1 {
			psels = <NRF_PSEL(QSPI_SCK, 0, 13)>,
			        <NRF_PSEL(QSPI_IO0, 0, 17)>,
			        <NRF_PSEL(QSPI_IO1, 0, 20)>,
			        <NRF_PSEL(QSPI_IO2, 0, 22)>,
			        <NRF_PSEL(QSPI_IO3, 0, 24)>,
			        <NRF_PSEL(QSPI_CSN, 0, 15)>;
			low-power-enable;
		};
	};
};
