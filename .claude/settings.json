{
  "permissions": {
    "allow": [
      "Bash(west build:*)",
      "Bash(west twister:*)",
      "Bash(west flash:*)",
      "Bash(west list:*)",
      "Bash(west status:*)",
      "Bash(west diff:*)",
      "Bash(ninja:*)",
      "Bash(cmake:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git grep:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(python -I:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(rm -rf:*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.env)"
    ]
  }
}
